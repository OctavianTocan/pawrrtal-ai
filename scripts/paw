#!/usr/bin/env bash
# Paw CLI launcher. Resolves symlinks so it works when invoked directly
# from anywhere on PATH (`paw doctor`) and delegates to the Python paw CLI
# inside `backend/app/cli/paw/`.
set -euo pipefail

launcher_path="${BASH_SOURCE[0]}"
while [[ -L "${launcher_path}" ]]; do
	launcher_dir="$(cd -P -- "$(dirname -- "${launcher_path}")" && pwd)"
	launcher_path="$(readlink -- "${launcher_path}")"
	if [[ "${launcher_path}" != /* ]]; then
		launcher_path="${launcher_dir}/${launcher_path}"
	fi
done

script_dir="$(cd -P -- "$(dirname -- "${launcher_path}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"
backend_dir="${repo_root}/backend"

if [[ ! -d "${backend_dir}" ]]; then
	printf 'Error: could not locate Pawrrtal backend at %s\n' "${backend_dir}" >&2
	exit 1
fi

if ! command -v uv >/dev/null 2>&1; then
	printf 'Error: uv is required to run paw. Install uv (https://docs.astral.sh/uv/) and try again.\n' >&2
	exit 1
fi

cd "${backend_dir}"
exec uv run python -m app.cli.paw "$@"